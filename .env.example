# Copy this file to .env and fill in the values below.
# Never commit .env — it's already in .gitignore.

# ---- LLM providers ----
# Default is Ollama — free, local, no API key, no rate limits, real Llama
# models. Nothing below is required to run this project. Set any of these
# cloud keys only if you want that provider as an option in the model
# picker (it's then used automatically wherever selected, and as an
# automatic fallback if Ollama is briefly unreachable).
LLM_PROVIDER=Ollama
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Ollama (self-hosted, free) ----
# docker-compose.yml runs an Ollama server and pre-pulls these two models
# before the app starts. Running outside Docker: install Ollama yourself
# (https://ollama.com/download) and `ollama pull` the same two models.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Deliberately left unset here so it defaults to the same value as
# OLLAMA_CHAT_MODEL (see config.js) — 1B-class models were meaningfully
# less reliable at this pipeline's multi-step structured reasoning
# (routing, grading, rewriting all happen in schema-constrained calls that
# need real judgment, not just valid JSON). Only set this to something
# smaller/faster after measuring its accuracy on your own gold-set
# questions — don't assume it's fine.
# OLLAMA_FAST_CHAT_MODEL=llama3.2:1b

# Cloud model ids — only matter if you set the matching API key above.
# Groq's catalog changes faster than most providers'; re-verify before
# relying on it: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
PRIMARY_LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ---- Embeddings ----
# "ollama" (default) needs no key and no quota — nomic-embed-text, real
# Llama-family chat pairs with it. "gemini" is there for anyone who does
# have Gemini budget/quota; requires GOOGLE_API_KEY or GEMINI_API_KEY above.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=models/gemini-embedding-001
# Must match whatever EMBEDDING_PROVIDER's model actually returns, or every
# Qdrant write is silently rejected with a dimension-mismatch error — this
# exact bug shipped once already (see vectorstore.js's startup check).
# Verified live: nomic-embed-text = 768, gemini-embedding-001 = 3072.
EMBEDDING_DIM=768

# ---- Vector store ----
# "auto" uses Qdrant when QDRANT_URL + QDRANT_API_KEY are set and reachable,
# otherwise falls back to an in-memory store (fine for local dev, NOT for
# production — the corpus is lost on every restart and isn't shared across
# replicas). Force one explicitly with "qdrant" or "memory".
VECTOR_BACKEND=auto
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_handbook

# ---- Postgres ----
# Backs the LangGraph checkpointer (conversation state + the human-approval
# gate) and the audit log. Required in production — the server refuses to
# boot in production without it. docker-compose.yml provisions this for you.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/agent_memory

# ---- GitHub tool ----
# Both required for the human-approved "file an issue" tool to actually
# execute. Use a fine-grained PAT scoped to Issues: Write on ONE repo —
# the repo below is the only one the tool will ever write to, regardless
# of anything a request tries to redirect it to.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# ---- Handbook source ----
# The real handbook (Hugo site), not gitlab-org/gitlab-foss (the product's
# source code, which has almost no markdown outside /doc). Verified live.
GITLAB_REPO=gitlab-com/content-sites/handbook
GITLAB_DOCS_PATH=content/handbook

# ---- Observability ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=enterprise-knowledge-agent
LANGSMITH_API_KEY=

# ---- Security ----
# API_KEY gates admin routes only (/ingest, /api/audit) — required in
# production. Generate one with: node -e "console.log(require('crypto').randomUUID())"
API_KEY=
# Signs the anonymous session cookie used for tenant scoping / rate limits.
# Required in production. Generate one the same way as API_KEY above.
SESSION_SECRET=
# Comma-separated list of origins allowed to call this API with credentials.
ALLOWED_ORIGINS=http://localhost:3000

# ---- Guardrails (sensible defaults — override only if you know why) ----
MIN_RELEVANCE_SCORE=0.28
MAX_REWRITES=2
MAX_REGENERATIONS=1
MAX_MESSAGE_LENGTH=4000
MAX_SYSTEM_PROMPT_LENGTH=800
MAX_UPLOAD_BYTES=10485760
DAILY_TOKEN_BUDGET_PER_SESSION=200000

# ---- Server ----
NODE_ENV=development
PORT=3000
