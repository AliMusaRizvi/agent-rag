# --- Primary LLM: Gemini (free tier, no card required) ---
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Fallback LLM: Groq (free tier, used automatically on Gemini 429s) ---
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional swap-in providers (job post lists both explicitly) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Vector DB ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_handbook

# --- Memory / checkpointing ---
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/agent_memory

# --- Tool integration ---
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-demo-repo

# --- Observability ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-knowledge-agent

# --- Model selection ---
PRIMARY_LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768
