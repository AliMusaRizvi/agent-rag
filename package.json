    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.10",
    "@qdrant/js-client-rest": "^1.19.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
